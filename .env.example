# NexaSmart Environment Configuration

# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/nexasmart
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nexasmart?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=nexasmart_super_secret_jwt_key_development_2026_xyz
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=nexasmart_refresh_token_secret_key_development_2026_abc
JWT_REFRESH_EXPIRES_IN=30d

# MQTT Broker Configuration
# Embedded Aedes broker runs automatically on 1883 if EMBEDDED_MQTT=true
EMBEDDED_MQTT=true
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=8883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=nexasmart-backend-service
MQTT_USERNAME=nexasmart_server
MQTT_PASSWORD=server_mqtt_secure_pass_2026

# Simulator
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=3000

# Tariffs & Thresholds
ELECTRICITY_RATE_PER_KWH=0.15
WATER_RATE_PER_LITER=0.002
